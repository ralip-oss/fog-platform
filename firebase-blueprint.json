{
  "entities": {
    "CatalogoItem": {
      "title": "CatalogoItem",
      "description": "Item do catálogo de produtos e serviços do Fog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "unidade": { "type": "string", "enum": ["unidade", "hora", "pacote"] },
        "precoUnitarioCentimos": { "type": "number" },
        "moeda": { "type": "string", "enum": ["EUR"] },
        "ativo": { "type": "boolean" },
        "condicoes": { "type": "string" },
        "demonstracao": { "type": "boolean" }
      },
      "required": ["id", "nome", "descricao", "unidade", "precoUnitarioCentimos", "moeda", "ativo"]
    },
    "Pedido": {
      "title": "Pedido",
      "description": "Registo de pedido de proposta submetido pelo cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "pedidoTexto": { "type": "string" },
        "dataCriacao": { "type": "string" },
        "dataAtualizacao": { "type": "string" },
        "estadoProcessamento": { "type": "string", "enum": ["recebido", "em_analise", "necessita_revisao", "proposta_criada", "erro"] },
        "interpretacaoIA": { "type": "string" },
        "informacaoEmFalta": { "type": "string" },
        "motivoRevisao": { "type": "string" },
        "propostaId": { "type": "string" },
        "erroProcessamento": { "type": "string" }
      },
      "required": ["id", "nome", "email", "pedidoTexto", "dataCriacao", "dataAtualizacao", "estadoProcessamento"]
    },
    "Proposta": {
      "title": "Proposta",
      "description": "Proposta comercial calculada e gerada pelo sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numeroProposta": { "type": "string" },
        "pedidoId": { "type": "string" },
        "dataCriacao": { "type": "string" },
        "dataValidade": { "type": "string" },
        "resumoAmbito": { "type": "string" },
        "itens": { "type": "string" },
        "totalCentimos": { "type": "number" },
        "condicoes": { "type": "string" },
        "token": { "type": "string" },
        "linkAcesso": { "type": "string" },
        "estadoNotificacao": { "type": "string", "enum": ["por_enviar", "aceite", "falhou", "nao_configurado"] },
        "emailServiceId": { "type": "string" },
        "dataTentativaEnvio": { "type": "string" },
        "erroEnvio": { "type": "string" },
        "demonstracao": { "type": "boolean" }
      },
      "required": ["id", "numeroProposta", "pedidoId", "dataCriacao", "dataValidade", "resumoAmbito", "totalCentimos", "token", "estadoNotificacao"]
    }
  },
  "firestore": {
    "/catalogo/{itemId}": {
      "schema": "CatalogoItem",
      "description": "Catálogo de produtos e serviços para cálculo de propostas"
    },
    "/pedidos/{pedidoId}": {
      "schema": "Pedido",
      "description": "Pedidos de proposta submetidos pelos clientes"
    },
    "/propostas/{propostaId}": {
      "schema": "Proposta",
      "description": "Propostas comerciais com preços e tokens de acesso"
    }
  }
}
