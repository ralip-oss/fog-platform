# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# RESEND_API_KEY: Resend API key for sending notifications to the student.
RESEND_API_KEY="re_123456789"

# EMAIL_ALUNO: Email address associated with the student's Resend account.
EMAIL_ALUNO="aluno@exemplo.com"

# APP_BASE_URL: Public base URL of the application for proposal links.
APP_BASE_URL="https://ais-dev-5a3tkhpljs5fqsvwvponnz-903076911045.europe-west2.run.app"

# ADMIN_UID: Firebase Auth UID of the authorized administrator user.
ADMIN_UID="YOUR_FIREBASE_AUTH_UID"
